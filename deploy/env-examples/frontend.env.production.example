# deploy/env-examples/frontend.env.production.example
# Production build-time variables — set as GitHub Actions repository secrets.
# NOT copied to the droplet. Injected during CI `npm run build` and baked into dist/.
#
# Public URLs: SPA + API on app.example.com; Keycloak on auth.app.example.com (dedicated vhost).

VITE_API_BASE_URL=https://app.example.com/api/v1
VITE_KEYCLOAK_URL=https://auth.app.example.com
VITE_KEYCLOAK_REALM=app
VITE_KEYCLOAK_CLIENT_ID=app-web

# Optional observability (production deploy job)
# VITE_SENTRY_DSN=
# VITE_SENTRY_RELEASE=${GITHUB_SHA}
# VITE_SENTRY_SEND_DEFAULT_PII=false
# VITE_SENTRY_ENABLE_SCREENSHOT=false

# Sourcemap upload at build time (workflow secrets — not VITE_*)
# SENTRY_AUTH_TOKEN=
# SENTRY_ORG=
# SENTRY_PROJECT=
