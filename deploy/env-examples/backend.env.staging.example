# deploy/env-examples/backend.env.staging.example
# Staging droplet — NOT the initial topology. Use when you add a second host.
# Initial deploy is backend.env.production.example on one droplet.
# Permissions: chmod 640, owned by deploy (readable for docker --env-file).
#
# cp deploy/env-examples/backend.env.staging.example /mnt/app_volume/backend/.env
#
# Mounted into: app-api, app-worker*, app-beat (and app-kc — Keycloak section below).
# NOT used by app-web (static SPA — VITE_* baked at CI build time).
#
# Container DNS names apply inside app-net (e.g. redis, keycloak).
# Staging droplet runtime. Cursor analysis uses STAGING_DATABASE_URL_READONLY in local backend/.env.

# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
ENVIRONMENT=staging
DEBUG=false
LOG_LEVEL=INFO
LOG_FORMAT=json
SECRET_KEY=GENERATE_WITH_python_-c_import_secrets_token_urlsafe_48
ALLOWED_ORIGINS=https://staging.app.example.com
TRUSTED_HOSTS=staging.app.example.com,backend

# -----------------------------------------------------------------------------
# Database — DigitalOcean managed PostgreSQL 17
# ENVIRONMENT=staging → STAGING_DATABASE_URL only
# -----------------------------------------------------------------------------
STAGING_DATABASE_URL=postgresql+asyncpg://saas_base-user-admin:CHANGE_ME@db-host.db.ondigitalocean.com:25060/saas_base_staging?ssl=require

# -----------------------------------------------------------------------------
# Redis — redis container on same droplet
# -----------------------------------------------------------------------------
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# -----------------------------------------------------------------------------
# Keycloak — app-kc container (also set KC_* for the Keycloak image)
# -----------------------------------------------------------------------------
KEYCLOAK_URL=http://keycloak:8080
KEYCLOAK_REALM=app
KEYCLOAK_ISSUER=https://auth.staging.app.example.com/realms/app
KEYCLOAK_CLIENT_ID=app-api
KEYCLOAK_CLIENT_SECRET=CHANGE_ME
KEYCLOAK_FRONTEND_CLIENT_ID=app-web
# KEYCLOAK_WEBHOOK_SECRET=

REGISTRATION_REQUIRE_ADMIN_APPROVAL=false
REGISTRATION_REQUIRE_PROFILE_FORM=false

# Keycloak server bootstrap (container env — often duplicated in compose `environment:`).
# Separate env for Keycloak — not STAGING_DATABASE_URL.

# -----------------------------------------------------------------------------
# Observability (optional)
# -----------------------------------------------------------------------------
SENTRY_DSN=
SENTRY_RELEASE=
SENTRY_SEND_DEFAULT_PII=false
SENTRY_TRACES_SAMPLE_RATE_PROD=0.1

# -----------------------------------------------------------------------------
# Email
# -----------------------------------------------------------------------------
EMAIL_PROVIDER=mailgun
EMAIL_FROM=noreply@staging.app.example.com
EMAIL_FROM_NAME=App
APP_PUBLIC_URL=https://staging.app.example.com
APP_NAME=App

# -----------------------------------------------------------------------------
# Stripe billing (optional) — docs/utils/STRIPE_BILLING_SETUP.md
# -----------------------------------------------------------------------------
# STRIPE_ENABLED=true
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_PRICE_PRO=price_...
# STRIPE_CHECKOUT_SUCCESS_URL=https://staging.app.example.com/settings/billing?checkout=success
# STRIPE_CHECKOUT_CANCEL_URL=https://staging.app.example.com/settings/billing?checkout=cancel

# -----------------------------------------------------------------------------
# Data export (W6 lifecycle — optional)
# -----------------------------------------------------------------------------
# EXPORT_STORAGE_PATH=/mnt/app_volume/exports
# EXPORT_TTL_DAYS=7
# MAILGUN_API_KEY=
# MAILGUN_DOMAIN=staging.app.example.com
# MAILGUN_REGION=eu
