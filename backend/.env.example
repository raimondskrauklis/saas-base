# backend/.env.example
# Copy to backend/.env for local development (DO NOT COMMIT .env)
#
#   cp .env.example .env
#
# Dev bootstrap: docs/starter-pack/DEV_BOOTSTRAP.md
# Registration flags: docs/starter-pack/REGISTRATION_FLAGS.md
#
# PostgreSQL: DigitalOcean managed — deploy/sql/postgres-extensions.sql and
# deploy/sql/postgres-readonly-role.sql once per app DB.
# Redis: start local broker with `docker compose up -d` in this directory.

# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=DEBUG
LOG_FORMAT=console
SECRET_KEY=local-dev-only-change-me
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# -----------------------------------------------------------------------------
# Database — DigitalOcean managed PostgreSQL 17
# ENVIRONMENT selects the FastAPI/Alembic bind (admin role) on this machine.
# Laptop: DEV_ + TEST_. Production schema: GitHub Actions on the droplet.
# Staging droplet is later — not the initial topology.
# *_READONLY — Cursor / analysis. Own keys (do not overwrite DEV_/TEST_ admin URLs).
# Copy the matching admin URL into these; user saas_base-user-readonly + that user’s DO password.
# -----------------------------------------------------------------------------
DEV_DATABASE_URL=postgresql+asyncpg://saas_base-user-admin:CHANGE_ME@db-host.db.ondigitalocean.com:25060/saas_base_dev?ssl=require
TEST_DATABASE_URL=postgresql+asyncpg://saas_base-user-admin:CHANGE_ME@db-host.db.ondigitalocean.com:25060/saas_base_test?ssl=require
# Droplet (GitHub Actions) — not migrated from this laptop:
# PRODUCTION_DATABASE_URL=postgresql+asyncpg://saas_base-user-admin:CHANGE_ME@db-host.db.ondigitalocean.com:25060/saas_base_prod?ssl=require
# Later, when you add a staging droplet:
# STAGING_DATABASE_URL=postgresql+asyncpg://saas_base-user-admin:CHANGE_ME@db-host.db.ondigitalocean.com:25060/saas_base_staging?ssl=require
DEV_DATABASE_URL_READONLY=postgresql+asyncpg://saas_base-user-readonly:CHANGE_ME@db-host.db.ondigitalocean.com:25060/saas_base_dev?ssl=require
TEST_DATABASE_URL_READONLY=postgresql+asyncpg://saas_base-user-readonly:CHANGE_ME@db-host.db.ondigitalocean.com:25060/saas_base_test?ssl=require
PRODUCTION_DATABASE_URL_READONLY=postgresql+asyncpg://saas_base-user-readonly:CHANGE_ME@db-host.db.ondigitalocean.com:25060/saas_base_prod?ssl=require
# STAGING_DATABASE_URL_READONLY=postgresql+asyncpg://saas_base-user-readonly:CHANGE_ME@db-host.db.ondigitalocean.com:25060/saas_base_staging?ssl=require

# -----------------------------------------------------------------------------
# Redis (backend/docker-compose.yml — local broker only)
# -----------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# -----------------------------------------------------------------------------
# Keycloak
# -----------------------------------------------------------------------------
KEYCLOAK_URL=http://localhost:8080
KEYCLOAK_REALM=app
# Optional when KEYCLOAK_URL is internal (docker) but browser tokens use a public issuer:
# KEYCLOAK_ISSUER=https://auth.app.example.com/realms/app
KEYCLOAK_CLIENT_ID=app-api
KEYCLOAK_CLIENT_SECRET=local-app-api-secret
KEYCLOAK_FRONTEND_CLIENT_ID=app-web
# KEYCLOAK_WEBHOOK_SECRET=

# Production docker: public API host plus the compose service name Keycloak POSTs to (Host: backend)
# TRUSTED_HOSTS=localhost,127.0.0.1,backend

# Registration — USER_REGISTRATION.md (mirror frontend VITE_REGISTRATION_*)
# Pairing table: docs/starter-pack/REGISTRATION_FLAGS.md
REGISTRATION_REQUIRE_ADMIN_APPROVAL=false
REGISTRATION_REQUIRE_PROFILE_FORM=false

# One-time first deploy — DELETE after super admin first login
# BOOTSTRAP_SUPER_ADMIN_EMAIL=you@example.com

# Email — console local, mailgun production
EMAIL_PROVIDER=console
APP_PUBLIC_URL=http://localhost:5173
APP_NAME=App
# EMAIL_FROM=noreply@localhost
# EMAIL_FROM_NAME=App
# MAILGUN_API_KEY=
# MAILGUN_DOMAIN=
# MAILGUN_REGION=eu

# -----------------------------------------------------------------------------
# Stripe billing (optional — STRIPE_ENABLED=false skips Checkout/Portal)
# Setup: docs/utils/STRIPE_BILLING_SETUP.md
# -----------------------------------------------------------------------------
STRIPE_ENABLED=false
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_PRICE_PRO=price_...
# STRIPE_CHECKOUT_SUCCESS_URL=http://localhost:5173/settings/billing?checkout=success
# STRIPE_CHECKOUT_CANCEL_URL=http://localhost:5173/settings/billing?checkout=cancel

# -----------------------------------------------------------------------------
# Data export (W6 — local path; set on API + worker in production)
# -----------------------------------------------------------------------------
# EXPORT_STORAGE_PATH=/tmp/app/exports
# EXPORT_TTL_DAYS=7

# -----------------------------------------------------------------------------
# Observability (optional)
# -----------------------------------------------------------------------------
SENTRY_DSN=
# SENTRY_RELEASE=
SENTRY_ENABLE_IN_TEST=false
